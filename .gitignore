.DS_Store
**/.DS_Store

# Python/local execution caches
__pycache__/
*.py[cod]
.pycache/
.pycache_tmp/
.pytest_cache/

# Local model/download caches and virtual environments
.modelscope-cache/
.venv/
.envs/

# Secrets and local provider credentials
data/secrets/
*.env
!*.env.example
api_default.env
*.pem
*.key

# External upstream baseline clones are documented in baselines/*/README.md.
# Keep wrappers, notes, and reproduction checklists in this repo, not vendored clones.
baselines/*/upstream/

# LaTeX/build byproducts; source PDFs can still be committed explicitly when needed.
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.synctex.gz
*.toc

# Temporary OS/editor files
*.swp
*~
.~*
*_backup.tex

# AAMAS execution records are delivered in the local artifact bundle.
# Keep source, configs, compact tables and audit documentation reviewable in Git.
artifacts/aamas2027/*/formal/
artifacts/aamas2027/*/pilot/
artifacts/aamas2027/E1_llm_agents/dry_run/
artifacts/aamas2027/MANIFEST.json
artifacts/aamas2027/BUNDLE_MANIFEST.json
artifacts/aamas2027/EXPERIMENT_SUMMARY.md
artifacts/aamas2027/PAPER_INTEGRATION.md
artifacts/aamas2027/report_data.json
aamas2027_experiment_bundle_*.zip

# E2-A generated safe evidence; identical gzip delivery is tracked.
/artifacts/aamas2027_e2a_combined/combined_index.json
/artifacts/aamas2027_e2a_combined/derived/artifact_index.json
/artifacts/aamas2027_e2a_combined/derived/episode_summary.json
/artifacts/aamas2027_e2a_combined/derived/failure_audit.json
/artifacts/aamas2027_e2a_combined/derived/principal_participation.json
/artifacts/aamas2027_e2a_combined/derived/release_audit.jsonl
/artifacts/aamas2027_e2a_combined/derived/stage_treatment_reachability.json
/artifacts/aamas2027_e2a_continuation/run/episodes.jsonl
